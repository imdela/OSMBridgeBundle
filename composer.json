{
	"name": "ossm/ossm-bridge-bundle",
	"description": "Symfony bundle bridging OpenSign (e-signature) and MinIO/S3 object storage",
	"type": "symfony-bundle",
	"license": "MIT",
	"require": {
		"php": ">=8.2",
		"guzzlehttp/guzzle": "^7.8",
		"symfony/console": "8.0.*",
		"symfony/framework-bundle": "8.0.*",
		"symfony/http-kernel": "8.0.*",
		"symfony/yaml": "8.0.*",
		"symfony/var-exporter": "8.0.*"
	},
	"require-dev": {
		"phpstan/phpstan": "^2.2",
		"symplify/easy-coding-standard": "^12.1",
		"phpunit/phpunit": "^10.5",
		"larament/dot-env-editor": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"Ossm\\OssmBridgeBundle\\": "src/"
		}
	}
}
